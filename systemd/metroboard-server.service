[Unit]
Description=MetroBoard local web and WMATA data service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/simon/metroboard
ExecStart=/home/simon/metroboard/scripts/run-server.sh
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
